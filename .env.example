# Where the API lives. On a physical device this must be your machine's LAN IP
# (e.g. http://192.168.1.5:5000) — localhost on a phone means the phone itself.
EXPO_PUBLIC_API_URL=http://localhost:5000

# Needed for push notifications on a real build.
# Get one with `eas init` inside this folder, or copy it from expo.dev.
EXPO_PUBLIC_EAS_PROJECT_ID=
